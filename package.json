{
  "name": "group",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:generate": "tsx --conditions=react-server --env-file-if-exists=.env.local ai/data/generate_synthetic.ts",
    "data:build": "tsx ai/data/build_splits.ts",
    "data:check": "tsx ai/data/check.ts",
    "model:calibrate": "tsx --conditions=react-server ai/data/calibrate.ts",
    "eval": "tsx --conditions=react-server --env-file-if-exists=.env.local evals/run.ts",
    "eval:report": "tsx evals/report.ts",
    "demo:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/demo/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.114",
    "@ai-sdk/openai-compatible": "3.0.87",
    "@huggingface/transformers": "4.3.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "ai": "7.0.166",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vercel/config": "0.14.1",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.3",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
