# Salin ke .env.local lalu isi. Jangan commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Situs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
CRON_SECRET=

# WhatsApp Cloud API
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Agen AI. AGENT_ENABLED=false mematikan agen.
AGENT_ENABLED=true
# gateway | google | openai-compatible
AGENT_STAGE2_PROVIDER=google
# Kosong = default penyedia (google: gemini-3.5-flash-lite). Wajib untuk openai-compatible.
AGENT_STAGE2_MODEL=
# json-text | native
AGENT_STAGE2_OUTPUT_MODE=json-text
# Khusus google: minimal | low | medium | high
AGENT_STAGE2_THINKING_LEVEL=minimal
# Penyedia google: kunci dari https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Penyedia gateway
AI_GATEWAY_API_KEY=
# Penyedia openai-compatible (Groq, OpenRouter, NVIDIA NIM, OpenCode Zen)
AGENT_STAGE2_BASE_URL=
AGENT_STAGE2_API_KEY=

# Akun demo (login demo dan npm run demo:seed)
DEMO_PEMBELI_EMAIL=
DEMO_PEMBELI_PASSWORD=
DEMO_GROSIR_EMAIL=
DEMO_GROSIR_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Video demo di halaman depan (dicetak oleh npm run demo:record)
DEMO_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_VIDEO_URL=
NEXT_PUBLIC_DEMO_POSTER_URL=
